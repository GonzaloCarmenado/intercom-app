# Copiar a .env.prod en el servidor de producción (no versionado, ver .gitignore)
# y rellenar con los valores reales. Nunca comitear este fichero con valores reales.

# Puerto en el que escucha el servicio dentro del contenedor. docker-compose.prod.yml
# ya lo publica solo en 127.0.0.1:8090 — cambiarlo aquí exige cambiar también el
# mapeo de puertos en ese fichero.
PORT=8090
